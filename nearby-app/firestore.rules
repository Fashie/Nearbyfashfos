rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default catch-all denies everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow delete: if isOwner(userId);
      allow update: if isOwner(userId) || (
        isSignedIn() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingsCount', 'totalRatingPoints', 'trustScore', 'meetupsCompleted', 'meetupHappened', 'ratedBy'])
      ) || (
        // Accepting/removing a friend needs to update BOTH users' documents, but a user
        // can only write their own doc under the rule above - so without this, the other
        // side's friendIds array silently never gets updated (permission-denied, swallowed
        // client-side), which is why account A kept showing "Add Friend" even after B
        // accepted. This lets any signed-in user add or remove ONLY their own uid to/from
        // someone else's friendIds array, and nothing else on the document - they still
        // cannot touch any other field or any other entry in that array.
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendIds']) &&
        (
          (
            request.resource.data.friendIds.size() == resource.data.get('friendIds', []).size() + 1 &&
            request.resource.data.friendIds.hasAll(resource.data.get('friendIds', [])) &&
            request.resource.data.friendIds.hasOnly(resource.data.get('friendIds', []) + [request.auth.uid])
          ) ||
          (
            request.resource.data.friendIds.size() == resource.data.get('friendIds', []).size() - 1 &&
            resource.data.get('friendIds', []).hasAll(request.resource.data.friendIds) &&
            resource.data.get('friendIds', []).hasOnly(request.resource.data.friendIds + [request.auth.uid])
          )
        )
      );

      // Sub-collections inside users
      match /messages/{messageId} {
        allow read, write: if isOwner(userId);
      }
      match /stories/{storyId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }
      match /posts/{postId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }
      match /highlights/{highlightId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }
      match /calls/{callId} {
        allow read, write: if isSignedIn();
      }
    }

    // Settings collection
    match /settings/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Visibility Settings collection
    match /visibilitySettings/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Top-level collections
    match /groups/{groupId} {
      allow read, write: if isSignedIn();
      
      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    match /locations/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    match /friendships/{friendshipId} {
      allow read, write: if isSignedIn();
    }

    match /friend_requests/{requestId} {
      allow read, write: if isSignedIn();
    }

    match /friend_requests_incoming/{requestId} {
      allow read, write: if isSignedIn();
    }

    match /friend_requests_outgoing/{requestId} {
      allow read, write: if isSignedIn();
    }

    match /friendRequests/{requestId} {
      allow read, write: if isSignedIn();
    }

    match /Conversations/{conversationId} {
      allow read, write: if isSignedIn();
    }

    match /messages/{messageId} {
      allow read, write: if isSignedIn();
    }

    match /direct_messages/{messageId} {
      allow read: if isSignedIn();

      // Real security enforcement of "friends-only messaging": a new message can only be
      // created if the sender is truthfully themselves (can't spoof senderId) AND the
      // sender's uid already appears in the receiver's friendIds array. Client-side checks
      // (in the app) are just UX - this is what actually stops a non-friend from writing a
      // message, since Firestore rules run no matter what the client tries to send.
      allow create: if isSignedIn() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.receiverId is string &&
        request.auth.uid in get(/databases/$(database)/documents/users/$(request.resource.data.receiverId)).data.get('friendIds', []);

      // Updates (marking read, reactions, edits, delete-for-me) and deletes are only
      // allowed for someone who was already a participant in that message thread.
      allow update, delete: if isSignedIn() &&
        request.auth.uid in resource.data.participants;
    }

    match /notifications/{notificationId} {
      allow read, write: if isSignedIn();
    }

    match /communities/{communityId} {
      allow read, write: if isSignedIn();
    }

    match /community_discussions/{discussionId} {
      allow read, write: if isSignedIn();
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /meetups/{meetupId} {
      allow read, write: if isSignedIn();
    }

    match /meetupRatings/{ratingId} {
      allow read, write: if isSignedIn();
    }

    match /liveLocations/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    match /safeMeetups/{placeId} {
      allow read, write: if isSignedIn();
    }

    match /presence/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    match /calls/{callId} {
      allow read, write: if isSignedIn();
    }
  }
}
