rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function areFriends(uidA, uidB) {
      return signedIn()
        && uidA is string
        && uidB is string
        && uidA != uidB
        && exists(/databases/$(database)/documents/users/$(uidA))
        && exists(/databases/$(database)/documents/users/$(uidB))
        && uidB in get(/databases/$(database)/documents/users/$(uidA)).data.get('friendIds', [])
        && uidA in get(/databases/$(database)/documents/users/$(uidB)).data.get('friendIds', []);
    }

    function validFriendIdsAdd(targetUserId) {
      // Don't assert an exact +1 size delta - arrayUnion is idempotent, so if this
      // pair's friendIds ever partially synced before (a prior accept/unfriend that
      // failed halfway), the array may already contain the caller's uid and a strict
      // size+1 check would wrongly deny an otherwise-correct, harmless write. Instead
      // assert the actual invariant: nothing removed, and the only possible addition
      // is the caller's own uid - true whether or not it was already present.
      let oldIds = resource.data.get('friendIds', []);
      let newIds = request.resource.data.get('friendIds', []);
      return signedIn()
        && targetUserId != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendIds'])
        && newIds.hasAll(oldIds)
        && newIds.hasOnly(oldIds.concat([request.auth.uid]))
        && request.auth.uid in newIds
        && exists(/databases/$(database)/documents/friend_requests/$(targetUserId + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/friend_requests/$(targetUserId + '_' + request.auth.uid)).data.get('senderId', '') == targetUserId
        && get(/databases/$(database)/documents/friend_requests/$(targetUserId + '_' + request.auth.uid)).data.get('receiverId', '') == request.auth.uid
        && get(/databases/$(database)/documents/friend_requests/$(targetUserId + '_' + request.auth.uid)).data.get('status', '') == 'pending';
    }

    function validFriendIdsRemove() {
      // Same idempotency issue as validFriendIdsAdd, mirrored for removal: assert
      // set semantics (nothing added, at most the caller's own uid removed) instead
      // of an exact -1 size delta, so an already-partially-unfriended pair doesn't
      // get stuck unable to finish unfriending.
      let oldIds = resource.data.get('friendIds', []);
      let newIds = request.resource.data.get('friendIds', []);
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendIds'])
        && oldIds.hasAll(newIds)
        && oldIds.hasOnly(newIds.concat([request.auth.uid]))
        && !(request.auth.uid in newIds);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId);

      allow update: if isOwner(userId)
        || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ratingsCount',
            'totalRatingPoints',
            'trustScore',
            'meetupsCompleted',
            'meetupHappened',
            'ratedBy'
          ])
        )
        || validFriendIdsAdd(userId)
        || validFriendIdsRemove();

      allow delete: if isOwner(userId);

      match /messages/{messageId} {
        allow read, write: if isOwner(userId);
      }

      match /stories/{storyId} {
        allow read: if signedIn();
        // Owner can do anything with their own stories. Anyone else signed-in may
        // only append themselves to the `viewers` array (view-tracking) - this is
        // what markStoryAsViewedInFirestore() actually does, and it was previously
        // blocked outright because only the owner could write here at all.
        allow write: if isOwner(userId)
          || (
            signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers'])
          );
      }

      match /posts/{postId} {
        allow read: if signedIn();
        allow write: if isOwner(userId);
      }

      match /highlights/{highlightId} {
        allow read: if signedIn();
        allow write: if isOwner(userId);
      }

      match /calls/{callId} {
        allow read: if signedIn() && (userId == request.auth.uid || areFriends(request.auth.uid, userId));
        allow create, update, delete: if signedIn() && (userId == request.auth.uid || areFriends(request.auth.uid, userId));
      }
    }

    match /settings/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /visibilitySettings/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /locations/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner(userId);
    }

    match /liveLocations/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner(userId);
    }

    match /presence/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner(userId);
    }

    match /friend_requests/{requestId} {
      allow read: if signedIn()
        && (
          resource.data.get('senderId', '') == request.auth.uid
          || resource.data.get('receiverId', '') == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.get('senderId', '') == request.auth.uid
        && request.resource.data.get('receiverId', '') is string
        && request.resource.data.get('receiverId', '') != request.auth.uid
        && request.resource.data.get('status', '') == 'pending';

      allow delete: if signedIn()
        && (
          resource.data.get('senderId', '') == request.auth.uid
          || resource.data.get('receiverId', '') == request.auth.uid
        );

      allow update: if signedIn()
        && (
          resource.data.get('senderId', '') == request.auth.uid
          || resource.data.get('receiverId', '') == request.auth.uid
        )
        && request.resource.data.get('senderId', '') == resource.data.get('senderId', '')
        && request.resource.data.get('receiverId', '') == resource.data.get('receiverId', '');
    }

    // Legacy request collections are intentionally blocked; the app uses friend_requests.
    match /friend_requests_incoming/{requestId} {
      allow read, write: if false;
    }

    match /friend_requests_outgoing/{requestId} {
      allow read, write: if false;
    }

    match /friendRequests/{requestId} {
      allow read, write: if false;
    }

    match /friendships/{friendshipId} {
      allow read, write: if false;
    }

    match /direct_messages/{messageId} {
      // The actual message schema (chatService.ts / useNearbyController.ts) is
      // senderId + receiverId only - there is no `participants` array on these
      // docs. The previous version of this rule required one, so every message
      // write was permission-denied. This checks the real fields instead.
      allow read: if signedIn()
        && (
          resource.data.get('senderId', '') == request.auth.uid
          || resource.data.get('receiverId', '') == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.get('senderId', '') == request.auth.uid
        && request.resource.data.get('receiverId', '') is string
        && request.resource.data.get('receiverId', '') != request.auth.uid
        && areFriends(request.auth.uid, request.resource.data.get('receiverId', ''));

      allow update, delete: if signedIn()
        && (
          resource.data.get('senderId', '') == request.auth.uid
          || resource.data.get('receiverId', '') == request.auth.uid
        );
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.get('userId', '') == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.get('senderId', '') == request.auth.uid
        && request.resource.data.get('userId', '') is string;
      allow update, delete: if signedIn() && resource.data.get('userId', '') == request.auth.uid;
    }

    match /groups/{groupId} {
      allow read, write: if signedIn();
      match /messages/{messageId} {
        allow read, write: if signedIn();
      }
    }

    match /Conversations/{conversationId} {
      allow read, write: if signedIn();
    }

    // Existing app-level collection. Keep it available so current working features do not break.
    match /messages/{messageId} {
      allow read, write: if signedIn();
    }

    match /posts/{postId} {
      allow read, write: if signedIn();
    }

    match /meetups/{meetupId} {
      allow read, write: if signedIn();
    }

    match /meetupRatings/{ratingId} {
      allow read, write: if signedIn();
    }

    match /safeMeetups/{placeId} {
      allow read, write: if signedIn();
    }

    match /communities/{communityId} {
      allow read, write: if signedIn();
    }

    match /community_discussions/{discussionId} {
      allow read, write: if signedIn();
    }

    match /calls/{callId} {
      allow read: if signedIn()
        && (
          resource.data.get('callerId', '') == request.auth.uid
          || resource.data.get('receiverId', '') == request.auth.uid
          || resource.data.get('callerUID', '') == request.auth.uid
          || resource.data.get('receiverUID', '') == request.auth.uid
        );

      allow create: if signedIn()
        && (
          request.resource.data.get('callerId', '') == request.auth.uid
          || request.resource.data.get('callerUID', '') == request.auth.uid
        )
        && (
          areFriends(request.auth.uid, request.resource.data.get('receiverId', ''))
          || areFriends(request.auth.uid, request.resource.data.get('receiverUID', ''))
        );

      allow update, delete: if signedIn()
        && (
          resource.data.get('callerId', '') == request.auth.uid
          || resource.data.get('receiverId', '') == request.auth.uid
          || resource.data.get('callerUID', '') == request.auth.uid
          || resource.data.get('receiverUID', '') == request.auth.uid
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
