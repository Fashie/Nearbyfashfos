rules_version = '2';

// NOTE: This file was MISSING from the project before this fix.
// Firebase Storage was therefore running on whatever default rules exist
// in the console (often deny-all, or rules that were never redeployed).
// Every upload (profile photo, highlights, posts, chat media, stories)
// was silently failing and falling back to storing raw base64 data
// directly inside Firestore documents (see uploadToStorage() in firebase.ts).
// That is the root cause of DP/highlight/post images "disappearing" after
// reload: the base64 fallback either blew past Firestore's 1MB document
// limit (silent write failure) or bloated the `users/{uid}` document that
// is read by every other online user on every app load, causing slow /
// dropped real-time sync across chat, radar and explore.
//
// Deploy this with: firebase deploy --only storage
// (make sure "storage": { "rules": "storage.rules" } is present in firebase.json)

service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos: anyone signed in can view, only the owner can write
    match /profiles/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Per-user assets: highlights, posts (nested under users/{uid}/...)
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 25 * 1024 * 1024;
    }

    // Standalone posts feed uploads
    match /posts/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 25 * 1024 * 1024;
    }

    // Story snaps (24h expiring)
    match /stories/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 15 * 1024 * 1024;
    }

    // Chat media — readable by any signed-in user (recipient needs access),
    // writable only by the sender (folder is keyed by sender uid)
    match /chat-images/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 15 * 1024 * 1024;
    }
    match /chat-videos/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 100 * 1024 * 1024;
    }
    match /voice-notes/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 20 * 1024 * 1024;
    }
    match /documents/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024;
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
