rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function image() {
      return request.resource.contentType.matches('image/.*') && request.resource.size <= 10 * 1024 * 1024;
    }

    function video() {
      return request.resource.contentType.matches('video/.*') && request.resource.size <= 50 * 1024 * 1024;
    }

    function audio() {
      return request.resource.contentType.matches('audio/.*') && request.resource.size <= 20 * 1024 * 1024;
    }

    function documentFile() {
      return request.resource.contentType.matches('application/.*') && request.resource.size <= 20 * 1024 * 1024;
    }

    match /profiles/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if owner(uid) && image();
      allow delete: if owner(uid);
    }

    match /posts/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if owner(uid) && (image() || video());
      allow delete: if owner(uid);
    }

    match /users/{uid}/posts/{fileName} {
      allow read: if signedIn();
      allow create, update: if owner(uid) && (image() || video());
      allow delete: if owner(uid);
    }

    match /users/{uid}/highlights/{fileName} {
      allow read: if signedIn();
      allow create, update: if owner(uid) && (image() || video());
      allow delete: if owner(uid);
    }

    match /stories/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if owner(uid) && (image() || video());
      allow delete: if owner(uid);
    }

    match /chat-images/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if owner(uid) && image();
      allow delete: if owner(uid);
    }

    match /chat-videos/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if owner(uid) && video();
      allow delete: if owner(uid);
    }

    match /voice-notes/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if owner(uid) && audio();
      allow delete: if owner(uid);
    }

    match /documents/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if owner(uid) && document();&& document(); documentFile();
      allow delete: if owner(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
